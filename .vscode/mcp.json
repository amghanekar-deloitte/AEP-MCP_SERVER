{
	"inputs": [
		{
			"type": "promptString",
			"id": "azure-devops-token",
			"description": "Azure DevOps Personal Access Token (PAT)",
			"password": true
		}
	],
	"servers": {
		"Stage": {
			"url": "https://aep-ai-ama-stage.adobe.io/mcp",
			"type": "http"
		},
		"azure-devops": {
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/c",
				"C:\\Program Files\\nodejs\\npx.cmd",
				"-y",
				"@tiberriver256/mcp-server-azure-devops"
			],
			"env": {
				"AZURE_DEVOPS_ORG_URL": "https://deloittebsg.visualstudio.com/",
				"AZURE_DEVOPS_AUTH_METHOD": "pat",
				"AZURE_DEVOPS_PAT": "${input:azure-devops-token}"
			}
		}
	}
}